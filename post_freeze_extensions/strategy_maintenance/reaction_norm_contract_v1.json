{
  "schema_version": 1,
  "study_id": "batter-strategy-maintenance-reaction-norm-v1",
  "classification": "post-outcome mechanism test; vertical unopened at freeze",
  "panels": [
    "hypsignathus",
    "phyllostomus_2022",
    "phyllostomus_2023"
  ],
  "stopped_panel": "phyllostomus_2016",
  "wind_state": {
    "variable": "sqrt(u10^2+v10^2)",
