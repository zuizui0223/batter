    "edges_m": [
      "-inf",
      -400,
      -200,
      -100,
      -50,
      0,
      50,
      100,
      200,
      400,
      "inf"
    ],
    "alpha": 0.5
  },
  "primary": "G_RN = log score same-individual wind-conditioned minus same-individual unconditioned",
  "secondary": "G_SELF = log score same-individual unconditioned minus other-individual wind-conditioned",
  "permutation": {
    "B": 4999,
    "unit": "whole session labels within cohort",
    "seeds": {
      "hypsignathus": 2026100301,
      "phyllostomus_2022": 2026100302,
      "phyllostomus_2023": 2026100303
    },
    "valid_min_evaluable_labels": 5
  },
  "support_rule": "observed-minus-null-mean > 0 and one-sided p <= 0.05"
}
