  "definitions": {
    "O_XY": "sum_c min[p_a(c),p_b(c)]",
    "O_Z_given_XY": "sum_c [min(p_a(c),p_b(c))/O_XY]*sum_z min[q_a(z|c),q_b(z|c)]",
    "O_XYZ": "sum_c,z min[p_a(c)*q_a(z|c),p_b(c)*q_b(z|c)]",
    "epsilon_pair": "O_XYZ/O_XY - O_Z_given_XY >=0, where q is smoothed 10-bin within-cell height distribution and O_XY>0",
    "R_3D_pair": "1-O_XYZ/O_XY = 1-O_Z_given_XY-epsilon_pair",
    "V_panel": "mean_same O_Z_given_XY - mean_other O_Z_given_XY, using original equal session/animal weights",
    "S_panel": "mean_other R_3D - mean_same R_3D = V_panel - (mean_other epsilon - mean_same epsilon), using same pair weights"
  },
